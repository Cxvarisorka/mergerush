{
  "name": "merge-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Merge Rush - a mobile-first 2D merge puzzle game",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sim": "vitest run tests/sim --reporter=verbose",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "cap:sync": "npm run build && cap sync",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "phaser": "3.90.0"
  }
}
